{
  "name": "spreadsheet-mcp-app",
  "version": "2.0.0",
  "description": "Interactive spreadsheet MCP App built with Skybridge",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/src/index.ts",
    "build:ui": "vite build",
    "build:server": "tsc -p tsconfig.json",
    "build": "npm run build:ui && npm run build:server",
    "start": "node dist/server/src/index.js",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jspreadsheet-ce": "^4.13.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "skybridge": "^1.2.7",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "jest": "^29.0.0",
    "ts-jest": "^29.4.11",
    "@types/jest": "^30.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
